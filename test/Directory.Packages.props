<Project>
    <!--
        Versions of the test-only packages. Shipped packages are versioned in src/Directory.Packages.props:
        Renovate derives the commit scope from the file path, and only deps(core) triggers a release.
    -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.5" />
        <PackageVersion Include="coverlet.collector" Version="10.1.0" />
        <PackageVersion Include="FluentAssertions" Version="8.11.0" />
        <PackageVersion Include="KubernetesClient" Version="21.0.8" />
        <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
        <PackageVersion Include="Microsoft.CodeAnalysis" Version="5.9.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
        <PackageVersion Include="Moq" Version="4.21.0" />
        <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.1" />
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
        <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
        <PackageVersion Include="xunit.analyzers" Version="2.3.0" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
        <PackageVersion Include="xunit.v3" Version="4.0.3" />
    </ItemGroup>

    <!--
        .NET-aligned packages follow the target framework, so the net10.0 tests run on the 10.x line.
        MSBuild 18.9.x is the last line that still ships net10.0 assets; 18.10.0 and later target net11.0.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Build.Framework" Version="18.9.6" />
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
        <PackageVersion Include="Microsoft.NET.StringTools" Version="18.9.6" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Build.Framework" Version="18.11.0" />
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
        <PackageVersion Include="Microsoft.NET.StringTools" Version="18.11.0" />
    </ItemGroup>
</Project>
