<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <EnablePreviewFeatures>true</EnablePreviewFeatures>
        <UsesMSBuildLocator>true</UsesMSBuildLocator>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\KubeOps.Cli\KubeOps.Cli.csproj" />
        <!-- No code reference: the integration tests load this project through MSBuild, which requires it to be restored. -->
        <ProjectReference Include="..\KubeOps.Cli.Test.Operator\KubeOps.Cli.Test.Operator.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="KubernetesClient" Version="21.0.8" />
        <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
        <PackageReference Include="Spectre.Console.Testing" Version="0.57.2" />
    </ItemGroup>
    <!--
        The CLI loads a project in its default configuration and resolves the project references from their output.
        Without a Debug build, the integration tests fail to find them. A build within a solution passes the
        configuration of the solution on to the references, so that context has to be removed.
    -->
    <Target Name="BuildCliTestOperatorInDebug" AfterTargets="Build" Condition="'$(Configuration)' != 'Debug'">
        <MSBuild Projects="..\KubeOps.Cli.Test.Operator\KubeOps.Cli.Test.Operator.csproj"
                 Properties="Configuration=Debug"
                 RemoveProperties="CurrentSolutionConfigurationContents;BuildingSolutionFile;TargetFramework" />
    </Target>
</Project>
