<Project>
    <!--
        Versions of the shipped packages. Test-only versions live in test/Directory.Packages.props:
        Renovate derives the commit scope from the file path, and only deps(core) triggers a release.
    -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="Aspire.Hosting" Version="13.6.5" />
        <PackageVersion Include="Aspire.Hosting.DevTunnels" Version="13.6.5" />
        <PackageVersion Include="Aspire.Hosting.Kubernetes" Version="13.6.5-preview.1.26559.7" />
        <PackageVersion Include="KubernetesClient" Version="21.0.8" />
        <PackageVersion Include="MessagePack" Version="3.1.12" />
        <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
        <PackageVersion Include="Microsoft.CodeAnalysis" Version="5.9.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.21.0-beta.1" />
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
        <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
        <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
        <PackageVersion Include="Spectre.Console" Version="0.57.2" />
        <PackageVersion Include="Spectre.Console.Analyzer" Version="1.0.0" />
        <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
        <PackageVersion Include="System.CommandLine" Version="3.0.0" />
        <PackageVersion Include="YamlDotNet" Version="18.1.0" />
        <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.9.0" />
    </ItemGroup>

    <!--
        .NET-aligned packages follow the target framework, so net10.0 consumers stay on the 10.x line.
        MSBuild 18.9.x is the last line that still ships net10.0 assets; 18.10.0 and later target net11.0.
    -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageVersion Include="Microsoft.Build.Framework" Version="18.9.6" />
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
        <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
        <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
        <PackageVersion Include="Microsoft.NET.StringTools" Version="18.9.6" />
        <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="10.0.15" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageVersion Include="Microsoft.Build.Framework" Version="18.12.2" />
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.0" />
        <PackageVersion Include="Microsoft.NET.StringTools" Version="18.12.2" />
        <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="11.0.0" />
    </ItemGroup>
</Project>
