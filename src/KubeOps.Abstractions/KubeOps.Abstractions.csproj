<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>KubeOps.Abstractions</PackageId>
        <PackageTags>Kubernetes Operator SDK Abstractions</PackageTags>
        <PackageDescription>
            Abstractions for the Kubernetes Operator SDK.
            Used by KubeOps in general.
        </PackageDescription>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="KubernetesClient" Version="21.0.8" />
        <PackageReference Include="ZiggyCreatures.FusionCache" Version="2.9.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
    </ItemGroup>

</Project>